# OpenAI Codex CLI 設定（chezmoi template）。参考: https://github.com/openai/codex/blob/main/docs/config.md
# 既定は fugu。chezmoi の [data] codexDefault / codexExtraProviders があるマシンだけ上書きする。

approval_policy = "on-request"
sandbox_mode = "workspace-write"

# 既定モデル。明示切替は別ファイル <name>.config.toml + `codex -p fugu` / `-p fugu-ultra`。
{{- if hasKey . "codexDefault" }}
{{ .codexDefault | trim }}
{{- else }}
model = "fugu"
model_provider = "sakana"
model_reasoning_effort = "high"
{{- end }}

[tui]
notifications = true
notification_condition = "unfocused"

[sandbox_workspace_write]
network_access = false

[history]
persistence = "save-all"

[[hooks.UserPromptSubmit]]
[[hooks.UserPromptSubmit.hooks]]
type = "command"
command = '$HOME/.codex/security-hooks/run-hook.sh codex $HOME/.codex/security-hooks/prompt-submit.ts'
timeout = 10

[[hooks.PostToolUse]]
matcher = "^apply_patch$"
[[hooks.PostToolUse.hooks]]
type = "command"
command = '$HOME/.codex/security-hooks/run-hook.sh codex $HOME/.codex/security-hooks/pattern-check.ts'
timeout = 10

[[hooks.Stop]]
[[hooks.Stop.hooks]]
type = "command"
command = '$HOME/.codex/security-hooks/run-hook.sh codex $HOME/.codex/security-hooks/stop-review.ts'
timeout = 120

[mcp_servers.fnox]
command = "fnox"
args = ["mcp"]

# Sakana AI プロバイダ。SAKANA_API_KEY は fnox 管理（fnox activate zsh で環境に載せる）。
[model_providers.sakana]
name = "Sakana API"
base_url = "https://api.sakana.ai/v1"
env_key = "SAKANA_API_KEY"
wire_api = "responses"
stream_idle_timeout_ms = 7200000
stream_max_retries = 5
request_max_retries = 4
{{- if hasKey . "codexExtraProviders" }}

{{ .codexExtraProviders | trim }}
{{- end }}
