#!/usr/bin/env bash
# plist: {{ include "private_Library/private_LaunchAgents/io.github.k35o.dotfiles-check.plist.tmpl" | sha256sum }}
set -euo pipefail

label="io.github.k35o.dotfiles-check"
domain="gui/$(id -u)"

launchctl bootout "$domain/$label" 2>/dev/null || true
# bootout は停止の完了を待たずに戻り、直後の bootstrap が失敗するため、消えるまで待つ
while launchctl print "$domain/$label" >/dev/null 2>&1; do
  sleep 0.1
done
launchctl bootstrap "$domain" "$HOME/Library/LaunchAgents/$label.plist"
